# Configuración pública de Supabase para el Portal Web (Next.js / Vercel)
# IMPORTANTE: Nunca coloques SUPABASE_SECRET_KEY ni SUPABASE_SERVICE_ROLE_KEY en variables NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplazar_con_tu_clave_publica
